# Environment variables for Todo AI Chatbot Containerized Services

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@your-neon-db-host.neon.tech/dbname

# Auth Secret (Generate a strong random string for production)
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production

# Service URLs for containerized environment (used internally)
# These are set by docker-compose by default:
# - BETTER_AUTH_URL=http://auth:4000
# - NEXT_PUBLIC_API_BASE_URL=http://backend:8000
# - NEXT_PUBLIC_BETTER_AUTH_URL=http://auth:4000